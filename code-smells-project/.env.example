# Copie para .env (ou exporte no shell) e troque os valores. Nunca versione valores reais.
SECRET_KEY=troque-por-um-valor-aleatorio-longo
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
TOKEN_MAX_AGE_SECONDS=28800
APP_ENV=producao
# Senha do usuário admin@loja.com, usada só quando o banco é criado (seed)
SEED_ADMIN_PASSWORD=troque-esta-senha
