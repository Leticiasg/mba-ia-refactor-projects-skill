# Exporte estas variáveis antes de `npm start` (o projeto não carrega .env sozinho).
PORT=3000
DB_PATH=:memory:
PAYMENT_GATEWAY_KEY=troque-pela-chave-do-gateway
# Token exigido no header X-Admin-Token das rotas administrativas. Vazio = rotas bloqueadas.
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio
LOG_LEVEL=info
